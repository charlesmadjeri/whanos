FROM maven:3.9-amazoncorretto-21 AS build

WORKDIR /src
COPY . .

RUN if [ -f "app/pom.xml" ]; then \
        mvn -B -f app/pom.xml -DskipTests dependency:resolve \
        && mvn -B -f app/pom.xml -DskipTests package \
        && cp app/target/app.jar /tmp/app.jar; \
    else \
        echo "app/pom.xml missing" >&2; exit 1; \
    fi

FROM eclipse-temurin:21-jre-jammy

WORKDIR /app
COPY --from=build /tmp/app.jar /app/app.jar

CMD ["java", "-jar", "app.jar"]
