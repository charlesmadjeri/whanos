#!/usr/bin/env python3
"""Sync terraform-generated Ansible vars into host_vars + group_vars/all.yml."""
from __future__ import annotations

import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
GENERATED = ROOT / "ansible/group_vars/tf.generated.yml"
HOST_VARS = ROOT / "ansible/host_vars/whanos.yml"
ALL_YML = ROOT / "ansible/group_vars/all.yml"
EXAMPLE = ROOT / "ansible/group_vars/all.example.yml"

# Keys Terraform owns; secrets stay in .env
MERGE_KEYS = (
    "vps_ip",
    "jenkins_url",
    "registry_host",
    "registry_name",
    "do_volume_device",
    "do_volume_mount",
    "jenkins_tmpdir",
)


def parse_simple_yaml_map(text: str) -> dict[str, str]:
    """Parse flat `key: "value"` / `key: value` lines (enough for tf.generated.yml)."""
    out: dict[str, str] = {}
    for line in text.splitlines():
        s = line.strip()
        if not s or s.startswith("#"):
            continue
        m = re.match(r"^([A-Za-z0-9_]+):\s*(.*)$", s)
        if not m:
            continue
        key, raw = m.group(1), m.group(2).strip()
        if raw.startswith(("'", '"')) and len(raw) >= 2 and raw[-1] == raw[0]:
            raw = raw[1:-1]
        out[key] = raw
    return out


def upsert(text: str, key: str, value: str) -> str:
    line = f'{key}: "{value}"'
    pattern = re.compile(rf"^{re.escape(key)}:\s*.*$", re.M)
    if pattern.search(text):
        return pattern.sub(line, text, count=1)
    if not text.endswith("\n"):
        text += "\n"
    return text + line + "\n"


def write_host_vars(gen: dict[str, str], header: str) -> None:
    HOST_VARS.parent.mkdir(parents=True, exist_ok=True)
    lines = [header.rstrip(), ""]
    for key in MERGE_KEYS:
        if key in gen and gen[key] != "":
            lines.append(f'{key}: "{gen[key]}"')
    # Preserve kube paths from generated file when present
    for key in ("local_kubeconfig_path", "kubeconfig_path"):
        if key in gen and gen[key] != "":
            lines.append(f'{key}: "{gen[key]}"')
    HOST_VARS.write_text("\n".join(lines).rstrip() + "\n", encoding="utf-8")


def main() -> int:
    if not GENERATED.is_file():
        print(f"Missing {GENERATED} — run make terraform-up first", file=sys.stderr)
        return 1
    if not ALL_YML.is_file():
        if EXAMPLE.is_file():
            ALL_YML.write_text(EXAMPLE.read_text(encoding="utf-8"), encoding="utf-8")
            print(f"Created {ALL_YML} from example")
        else:
            print(f"Missing {ALL_YML}", file=sys.stderr)
            return 1

    raw = GENERATED.read_text(encoding="utf-8")
    gen = parse_simple_yaml_map(raw)
    header = next(
        (ln for ln in raw.splitlines() if ln.startswith("#")),
        "# Generated by Terraform — do not commit. Secrets stay in repo-root .env.",
    )
    write_host_vars(gen, header)
    print(f"Wrote {HOST_VARS.relative_to(ROOT)} (Ansible auto-loads this; overrides all.yml)")

    text = ALL_YML.read_text(encoding="utf-8")
    changed = []
    for key in MERGE_KEYS:
        if key not in gen or gen[key] == "":
            continue
        new_text = upsert(text, key, gen[key])
        if new_text != text:
            changed.append(key)
            text = new_text
    ALL_YML.write_text(text, encoding="utf-8")
    if changed:
        print("Also synced into all.yml:", ", ".join(changed))
    else:
        print("all.yml already up to date with tf.generated.yml")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
