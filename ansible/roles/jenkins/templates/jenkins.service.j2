[Unit]
Description=Jenkins Continuous Integration Server
Requires=network.target
After=network.target

[Service]
Type=simple
User=jenkins
Group=jenkins
# Secrets live in EnvironmentFile so passwords with %/#/& are not parsed as
# systemd specifiers (Environment= would drop JENKINS_ADMIN_PASSWORD).
EnvironmentFile=-/etc/jenkins/whanos.env
Environment="JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64"

ExecStart=/usr/bin/java -Djenkins.install.runSetupWizard=false{% if jenkins_tmpdir | default('') %} -Djava.io.tmpdir={{ jenkins_tmpdir }}{% endif %} -Xmx256m -jar /usr/share/java/jenkins.war
Restart=on-failure
RestartSec=10
LimitNOFILE=65536
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
