---
# CI-friendly defaults for ansible-lint
profile: min
skip_list:
  - experimental
  - fqcn[action-core]
  - fqcn[action]
  - name[casing]
  - yaml[line-length]
  - yaml[truthy]
  - yaml[new-line-at-end-of-file]
  - yaml[trailing-spaces]
  - risky-file-permissions
  - no-handler
  - no-changed-when
  - command-instead-of-module
  - galaxy[no-changelog]
  - var-naming[no-role-prefix]
  - jinja[spacing]
exclude_paths:
  - ansible/group_vars/all.yml
  - docs/
