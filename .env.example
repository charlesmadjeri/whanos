# Repo-root secrets for local ops (gitignored). Copy: cp .env.example .env
#
# Used by: make terraform-* / make infra, doctl, DigitalOcean Terraform provider.
# Jenkins Compose still uses jenkins/.env separately.

DIGITALOCEAN_TOKEN=
# doctl also accepts DIGITALOCEAN_ACCESS_TOKEN (same value is fine)
# DIGITALOCEAN_ACCESS_TOKEN=
