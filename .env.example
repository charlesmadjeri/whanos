# Repo-root secrets & local config (gitignored). Copy: cp .env.example .env
#
# Used by:
#   - make terraform-* / make infra / doctl  (DIGITALOCEAN_TOKEN)
#   - docker compose                         (Jenkins Casc + registry)
#   - make run-ansible                       (password + registry via env lookup)
#
# Non-secret infra facts (vps_ip, do_volume_*, tls paths) stay in
# ansible/group_vars/all.yml and/or tf.generated.yml after Terraform.

# --- DigitalOcean / Terraform / doctl ---
DIGITALOCEAN_TOKEN=
# Optional alias (auto-mirrored from DIGITALOCEAN_TOKEN by Make / nix-shell):
# DIGITALOCEAN_ACCESS_TOKEN=

# --- Jenkins (Compose + Ansible) ---
# Quote values that contain # ! $ % & when the file is shell-sourced:
#   JENKINS_ADMIN_PASSWORD='...'
# Make uses scripts/with-dotenv (do not `include` this file in Make — # is a comment).
JENKINS_ADMIN_PASSWORD=change_me
# Compose default (Ansible always uses http://{{ vps_ip }})
JENKINS_URL=http://localhost:8080
CASC_JENKINS_CONFIG=/opt/whanos/jenkins/casc/jenkins-config.yml

# --- Container registry (DOCR) ---
REGISTRY_HOST=registry.digitalocean.com
REGISTRY_NAME=whanos
REGISTRY_USERNAME=your.email@example.com
# Defaults to DIGITALOCEAN_TOKEN when empty (Make + Ansible)
REGISTRY_TOKEN=

# --- Kubeconfig paths (Compose bind-mount uses kubeconfig.yaml at repo root) ---
LOCAL_KUBECONFIG_PATH=kubeconfig.yaml
KUBECONFIG_PATH=/var/lib/jenkins/kube/config
